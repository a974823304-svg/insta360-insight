# ============================================================
# Insta360 达人营销数据洞察平台 · 后端环境变量
# 复制为 .env(或写入系统环境变量)后填写。不填则全部走 MockAdapter 演示数据。
# ============================================================

# 数据源选择: mock(默认) / douyin / bilibili / xiaohongshu
# 选了真实平台但没填对应凭证时,会自动回退 MockAdapter(看板永远有数据、不崩)。
SOURCE=mock

# ---- 抖音开放平台 / 巨量星图 ----
# 方式一(推荐,无需用户授权):应用级 client_token
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 方式二(优先级更高):已通过 OAuth2 拿到的用户 access_token
DOUYIN_ACCESS_TOKEN=
# 可选:接口域名(默认 https://open.douyin.com)
DOUYIN_BASE_URL=

# ---- 哔哩哔哩开放平台 ----
# B站没有应用级 token,必须先用授权码流程拿到用户 access_token 填这里:
BILIBILI_ACCESS_TOKEN=
# 应用凭证(用于接口 v2 HMAC-SHA256 签名):
BILIBILI_CLIENT_ID=
BILIBILI_CLIENT_SECRET=
BILIBILI_BASE_URL=

# ---- 小红书蒲公英 / 第三方聚合 ----
# 蒲公英官方:商家授权 access_token;或第三方聚合(如 Just One API)的 API key
XHS_ACCESS_TOKEN=
XHS_APP_ID=
XHS_APP_SECRET=
# 蒲公英创作者核心指标需要 userId:
XHS_USER_ID=
# 用聚合服务时把 BASE_URL 指向聚合网关,例如 https://api.justoneapi.com
XHS_BASE_URL=

# ---- 既有变量(保持不变) ----
JWT_SECRET=
AUTH_DISABLE=
ENV=
DB_PATH=
AVATAR_DIR=
SEED_ADMIN_USER=
SEED_ADMIN_PASS=
